# --- Database Configuration ---
POSTGRES_DB=orstac_cognitive
POSTGRES_USER=orstac_admin
POSTGRES_PASSWORD=orstac_secure_password_replace_me
POSTGRES_PORT=5432

# --- n8n Configuration ---
N8N_PORT=5678
N8N_HOST=localhost
TIMEZONE=America/Sao_Paulo

# --- AI & LLM API Keys ---
# Primary LLM Brain: Gemini API Key (Get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM Brain: DeepSeek API Key (Get from DeepSeek Console)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: DeepSeek Base API URL (e.g. for self-hosted Ollama or RunPod)
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_URL=http://localhost:11434/v1
